      </inherit>
    </Item>
    <Item identifier="pucs">
      <inherit identifier="pucs">
        <doinherit/>
        <!-- item sprite on ground -->
        <replace sel="./Sprite">
          <Sprite name="PUCS Item" texture="%ModDir%/Content/Items/Jobgear/Engineer/PUCS_Items.png" sourcerect="0,0,160,120" depth="0.55" origin="0.4625,0.5" />
        </replace>
        <!-- contained sprite, Vertical Locker -->
        <replace sel="./ContainedSprite[@allowedcontainertags='divingsuitcontainervertical']">
          <ContainedSprite name="PUCS In Vertical Locker" allowedcontainertags="divingsuitcontainervertical" texture="%ModDir%/Content/Items/Jobgear/Engineer/PUCS_Items.png" sourcerect="164,0,87,190" depth="0.55" origin="0.5,0.5" />
