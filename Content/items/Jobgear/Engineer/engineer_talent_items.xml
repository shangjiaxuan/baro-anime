        <replace sel="./ContainedSprite[@allowedcontainertags='divingsuitcontainerwindow']">
          <ContainedSprite name="PUCS Behind Window" allowedcontainertags="divingsuitcontainerwindow" texture="pucs.png" sourcerect="430,0,80,207" depth="0.55" origin="-0.12,-0.13" />
