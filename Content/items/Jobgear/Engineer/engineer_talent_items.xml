        <replace sel="./Wearable/StatusEffect/@PropulsionSpeedMultiplier">1.4</replace>
        <replace sel="./Wearable/damagemodifier[@afflictionidentifiers='radiationsickness']/@damagemultiplier">0.0</replace>
