<?xml version="1.0" encoding="utf-8"?>
<Override>
  <Item identifier="assistantclothes">
    <inherit identifier="assistantclothes">
      <doinherit/>
      <replace sel="./InventoryIcon/@texture">
        %ModDir%/Content/Items/Jobgear/OutfitIcons.png
      </replace>
      <replace sel="./InventoryIcon/@sourcerect">384,198,128,99</replace>
      <del sel = "./Wearable/sprite"/>
      <add sel = "./Wearable">
        <sprite name="Assistant's Uniform Torso" texture="Assistant.png" limb="Torso" hidelimb="false" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
        <sprite name="Assistant's Uniform Right Hand" texture="Assistant.png" limb="RightHand" hidelimb="false" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
        <sprite name="Assistant's Uniform Left Hand" texture="Assistant.png" limb="LeftHand" hidelimb="false" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
        <sprite name="Assistant's Uniform Left Lower Arm" texture="Assistant.png" limb="LeftForearm" hidelimb="false" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
        <sprite name="Assistant's Uniform Right Lower Arm" texture="Assistant.png" limb="RightForearm" hidelimb="false" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
        <sprite name="Assistant's Uniform Left Upper Arm" texture="Assistant.png" limb="LeftArm" hidelimb="true" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
        <sprite name="Assistant's Uniform Right Upper Arm" texture="Assistant.png" limb="RightArm" hidelimb="true" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
        <sprite name="Assistant's Uniform Waist" texture="Assistant.png" limb="Waist" hidelimb="true" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
        <sprite name="Assistant's Uniform Right Thigh" texture="Assistant.png" limb="RightThigh" hidelimb="false" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
        <sprite name="Assistant's Uniform Left Thigh" texture="Assistant.png" limb="LeftThigh" hidelimb="false" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
        <sprite name="Assistant's Uniform Right Leg" texture="Assistant.png" limb="RightLeg" hidelimb="true" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
        <sprite name="Assistant's Uniform Left Leg" texture="Assistant.png" limb="LeftLeg" hidelimb="true" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
        <sprite name="Assistant's Uniform Right Shoe" texture="Assistant.png" limb="RightFoot" hidelimb="true" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
        <sprite name="Assistant's Uniform Left Shoe" texture="Assistant.png" limb="LeftFoot" hidelimb="true" inherittexturescale="true" inheritorigin="true" inheritsourcerect="true" />
      </add>
    </inherit>
      <ItemComponent>
      <StatusEffect type="OnWearing" target="Character">
        <Affliction identifier="Heels" amount="1" />
      </StatusEffect>
    </ItemComponent>
  </Item>
</Override>