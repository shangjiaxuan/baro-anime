<?xml version="1.0" encoding="utf-8"?>
<Items>
  <Override>
    <item identifier="divingsuitlocker2">
      <inherit identifier="divingsuitlocker2">
        <doinherit/>
        <replace sel="./ItemContainer/Containable/@items">
          divingsuit,abyssdivingsuit,combatdivingsuit,pucs,slipsuit,Wf_pucs,Wf_pucs_R,Wf_pucs_B,Wf_pucs_D,Wf_New_XDS-01
        </replace>
      </inherit>
    </item>
    <item identifier="divingsuitlocker">
      <inherit identifier="divingsuitlocker">
        <doinherit/>
        <replace sel="./ItemContainer/Containable/@items">
          divingsuit,abyssdivingsuit,combatdivingsuit,pucs,slipsuit,Wf_pucs,Wf_pucs_R,Wf_pucs_B,Wf_pucs_D,Wf_New_XDS-01
        </replace>
      </inherit>
    </item>
  </Override>
  <Item name="" identifier="XDS-01_ChargingPod" category="Equipment" tags="Pod" pickdistance="50" isshootable="true" scale="0.65">
    <Body width="160" height="300" density="50" />
    <BrokenSprite texture="XDS-Pod_1.png" sourcerect="0,0,211,381" maxcondition="90" />
    <BrokenSprite texture="XDS-Pod_2.png" sourcerect="0,0,211,381" maxcondition="80" />
    <Fabricate suitablefabricators="fabricator" requiredtime="40">
      <RequiredSkill identifier="electrical" level="80" />
      <RequiredSkill identifier="mechanical" level="80" />
      <Item identifier="organicfiber" amount="16" />
      <Item identifier="physicorium" amount="6" />
      <Item identifier="fpgacircuit" />
      <Item identifier="fulgurium" amount="3" />
      <Item identifier="Wf_Research_chip_B" />
    </Fabricate>
    <Deconstruct time="40">
      <Item identifier="organicfiber" amount="16" />
      <Item identifier="physicorium" amount="6" />
      <Item identifier="fpgacircuit" />
      <Item identifier="fulgurium" amount="3" />
    </Deconstruct>
    <Sprite name="Diving Suit Locker Vertical" texture="XDS-Pod.png" sourcerect="0,0,211,381" depth="0.6" origin="0.5,0.5" />
    <Controller UserPos="0,-20" AllowInGameEditing="false" HideHUD="false" direction="Right" canbeselected="true" AllowSelectingWhenSelectedByBot="false" AllowSelectingWhenSelectedByOther="false" selectkey="Use" drawuserbehind="true" forceusertostayattached="true" msg="itemmsggoinside">
      <RequiredItem tags="XDS-01" type="Picked" msg="ItemMsgUnauthorizedAccess" ignoreineditor="true" />
      <limbposition limb="Head" position="74,-40" />
      <limbposition limb="Torso" position="74,-40" />
      <limbposition limb="Waist" position="74,-40" />
      <limbposition limb="LeftHand" position="74,-40" />
      <limbposition limb="RightHand" position="74,-40" />
      <limbposition limb="RightLeg" position="74,-40" />
      <limbposition limb="LeftLeg" position="74,-40" />
      <limbposition limb="RightFoot" position="74,-40" />
      <limbposition limb="LeftFoot" position="74,-40" />
      <LightComponent range="0.0" PowerConsumption="10" lightcolor="255,255,255,100" blinkfrequency="1" AllowInGameEditing="false" IsOn="false">
        <Sprite texture="%ModDir%/Content/Items/Containers/XDS-Pod_Lights.png" sourcerect="0,0,211,381" depth="0.54" origin="0.5,0.5" alpha="1.0" />
      </LightComponent>
      <StatusEffect type="OnActive" target="This" delay="0.25" setvalue="true" Voltage="1.0" TargetitemComponent="LightComponent" IsOn="true" checkconditionalalways="true" />
      <!--Hide character-->
      <StatusEffect type="OnActive" target="Character" indetectable="true" DisableFocusingOnEntities="true" invisibletimer="0.1" IgnoreMeleeWeapons="true" PressureProtection="10000.0" setvalue="true" />
      <!--Check XDS-01's Condition
		<StatusEffect type="OnActive" target="Character" StatusEffectTags="NeedCharging" duration="0.02" interval="0.01">
        <Conditional HasStatusTag="eq NotFullyChraged" />
      </StatusEffect>-->
      <!--Initialization, hide and lock player-->
      <StatusEffect type="OnActive" target="Character" delay="0.25" checkconditionalalways="true" interval="1">
        <Affliction identifier="Charging" amount="1" />
      </StatusEffect>
      <!--Change Sprite while actived-->
      <StatusEffect type="OnActive" target="Character,this" condition="90" setvalue="true">
        <Conditional XDS-01="gt 0" />
      </StatusEffect>
      <StatusEffect type="OnActive" target="Character,this" condition="80" setvalue="true">
        <Conditional XDS-01_B="gt 0" />
      </StatusEffect>
      <!--Beep when fully charaged
	  <StatusEffect type="OnActive" target="Character"  checkconditionalalways="true" interval="0.04">
		<Conditional HasStatusTag="! NeedCharging" />
		<sound file="%Moddir%/Content/Sounds/Pod_finished.ogg" rang="500" volume="0.8"/>
	  </StatusEffect>
	  -->
      <!--Return conditon to 100 when not activing.-->
      <StatusEffect type="Always" target="This" condition="100" setvalue="true" checkconditionalalways="true">
        <Conditional IsActive="false" />
      </StatusEffect>
    </Controller>
    <Holdable selectkey="Select" pickkey="Select" slots="RightHand+LeftHand" msg="XdsPick" PickingTime="5.0" aimpos="85,-10" handle1="0,0" attachable="true" aimable="true" attachedbydefault="true">
      <RequiredItem items="wrench,deattachtool" excludeditems="multitool" type="Equipped" />
    </Holdable>
  </Item>
</Items>